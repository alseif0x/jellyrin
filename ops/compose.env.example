# Copy this file to the repository root as `.env`, keep it mode 0600, and replace every value.
# Hex secrets avoid reserved URL characters because Compose injects the two database passwords
# into PostgreSQL connection URLs. Generate each independently with: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=

# Optional. Required only when `--profile distributed-cache` (or `cache`) is enabled.
REDIS_PASSWORD=

# Keep mutable application settings in an ignored local copy, not in the tracked example.
JELLYRIN_ENV_FILE=./ops/jellyrin.env
JELLYRIN_PUBLISH_ADDRESS=127.0.0.1
JELLYRIN_HOST_PORT=8096
# Used only with `-f docker-compose.provider-secrets.yml`. Point to an absolute host file owned by
# root:10001 with mode 0440; never place its key material in this env file.
JELLYRIN_PROVIDER_SECRET_KEYRING_HOST_FILE=
# Local builds use the Dockerfile lock below. For a published release, replace this with the
# promoted registry reference including its immutable `@sha256:` image digest and use `--no-build`.
JELLYRIN_IMAGE=jellyrin:local

# Public supply-chain inputs mirrored from ops/supply-chain.lock.env. Change them only as one
# reviewed lock update; `node qa/supply-chain.js` rejects partial or tag-only updates.
RUST_IMAGE=docker.io/library/rust:1.94.0-bookworm@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f
RUNTIME_IMAGE=docker.io/library/debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
DISTROLESS_IMAGE=gcr.io/distroless/cc-debian13:nonroot@sha256:d97bc0a941b8d4be647dc0ee75b264ddbb772f1ac5ba690a4309c00723b23775
POSTGRES_IMAGE=docker.io/library/postgres:17.10-bookworm@sha256:9b18b78397054fce88a9552e9d5a3ad5bb7fd258c5b3cc1c5028e46373d6ea8f
REDIS_IMAGE=docker.io/library/redis:8.2.8-bookworm@sha256:2f7462b9e93e0a7ae2edf3a0a0babc8a4d29f8bfc50849b906b7caaef925edc1
DEBIAN_SNAPSHOT=20260808T000000Z
FFMPEG_SOURCE_REVISION=1e0279143db99d7324b17f9784b3229122269b38
FFMPEG_SOURCE_VERSION=8.2-dev-git-1e0279143db9
FFMPEG_NVD_BASELINE_VERSION=8.1.2
FFMPEG_SOURCE_SHA256=2eb566ff9b41802220974bf9457da9bdbda078b1f56d1f008525b7b7cd71ca40
# Set this to the exact source commit when producing a release image.
JELLYRIN_VCS_REF=local

# The container cap includes FFmpeg children, protecting CPU and memory for PostgreSQL/the host.
JELLYRIN_CPU_LIMIT=1.5
JELLYRIN_MEMORY_LIMIT=2g
