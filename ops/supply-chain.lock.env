# The dated Debian snapshot fixes the build/runtime dependency closure. FFmpeg is built from the
# official commit archive and its digest were independently checked before pinning. The NVD
# baseline is the last stable release whose HIGH/CRITICAL findings must all map to verified fixes.
DEBIAN_SNAPSHOT=20260808T000000Z
FFMPEG_SOURCE_REVISION=1e0279143db99d7324b17f9784b3229122269b38
FFMPEG_SOURCE_VERSION=8.2-dev-git-1e0279143db9
