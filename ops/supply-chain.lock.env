# Jellyfin Web is built from this immutable upstream source archive. The archive checksum is for
# GitHub's commit-addressed tarball, not a mutable release asset or branch snapshot. The official
# minimal security patch is the merged PR #7617 head commit; its commit patch only changes
# package.json and package-lock.json to move Swiper to the first fixed release.
JELLYFIN_WEB_VERSION=10.11.11
JELLYFIN_WEB_COMMIT=35c0793ece3adbd247eab290ae1effab851f3d37
