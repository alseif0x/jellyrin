# Legacy/custom-path override only. The supplied jellyrin.service already loads the keyring from
# /etc/jellyrin-secrets/provider-secret-keyring.json; do not install this unchanged alongside it.
# To use another root-only source, reset LoadCredential first, set one replacement, and run
# daemon-reload. The source must be a regular file owned by root and mode 0400.
[Service]
LoadCredential=
LoadCredential=provider-secret-keyring.json:/etc/jellyrin-secrets/provider-secret-keyring.json
Environment=JELLYRIN_PROVIDER_SECRET_KEYRING_FILE=%d/provider-secret-keyring.json
