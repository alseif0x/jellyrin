# Install as /etc/jellyrin-migrate.env (root:root, mode 0600). This DDL-capable URL is for the
# one-shot systemd migration unit only. Never load it into Jellyrin's runtime service.
# Use sslmode=verify-full when PostgreSQL is not local/private.
DATABASE_URL=postgresql://jellyrin_migrator:CHANGE_ME@127.0.0.1:5432/jellyrin?sslmode=disable
RUST_LOG=jellyrin_migrate=info
