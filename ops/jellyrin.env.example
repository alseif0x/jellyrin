JELLYRIN_HOST=0.0.0.0
JELLYRIN_PORT=8096
JELLYRIN_DATA_DIR=/var/lib/jellyrin
JELLYRIN_CONFIG_DIR=/etc/jellyrin
JELLYRIN_CACHE_DIR=/var/cache/jellyrin
JELLYRIN_LOG_DIR=/var/log/jellyrin
JELLYRIN_WEB_DIR=/srv/jellyrin/web
JELLYRIN_DATABASE_ENGINE=sqlite
DATABASE_URL=sqlite:///var/lib/jellyrin/jellyrin.db?mode=rwc
RUST_LOG=jellyrin=info,tower_http=info

# Optional MAGSTV runtime fallback. The preferred path is the MAGSTV plugin
# configuration page, which persists credentials in the server database.
# Keep real environment values outside this file.
# MAGSTV_PORTAL_KEY_METADATA=<hex PORTAL_KEY metadata from the local APK>
# MAGSTV_SECRET_MAGSTV_ACCOUNT_USERNAME=<account username>
# MAGSTV_SECRET_MAGSTV_ACCOUNT_PASSWORD=<account password>
# Optional device/common-field overrides:
# MAGSTV_DEVICE_ID=jellyrin
# MAGSTV_SN=<device serial>
# MAGSTV_EGRESS_PROXY=http://127.0.0.1:18080
# Use MAGSTV_EGRESS_PROXY=direct only when the host itself already routes
# through the authorised Mexican egress (the sidecar is then unnecessary).
#
# MAGSTV VOD playback (JIT). The signing secret is 21 bytes as hex and must
# come from the deployment secret mechanism, never from the repository:
# JELLYRIN_MAGSTV_SIGN_O3_SECRET_HEX=<42 hex chars>
# The CDN edge host is learned per deployment; the plugin configuration field
# CdnEdgeHost is preferred, this variable is the fallback:
# JELLYRIN_MAGSTV_CDN_EDGE_HOST=<cdn edge host>
# Optional explicit public egress IP bound into signed CDN URLs (discovered
# automatically when unset):
# JELLYRIN_MAGSTV_EGRESS_IP=<ipv4>
# The default points at the isolated MX WireGuard sidecar. Do not replace it
# with a direct route for a live account; container deployments use the
# service name from docker-compose.magstv-egress.yml.
