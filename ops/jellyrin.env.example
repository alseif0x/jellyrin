# Reverse-proxy/systemd default: never expose the unauthenticated HTTP backend off-host.
# Docker Compose overrides the in-container bind and publishes its port on host loopback only.
JELLYRIN_HOST=127.0.0.1
JELLYRIN_PORT=8096
JELLYRIN_DATA_DIR=/var/lib/jellyrin
JELLYRIN_CONFIG_DIR=/etc/jellyrin
JELLYRIN_CACHE_DIR=/var/cache/jellyrin
JELLYRIN_LOG_DIR=/var/log/jellyrin
JELLYRIN_WEB_DIR=/srv/jellyrin/web
# Runtime URL only: this role must not own the schema or have DDL privileges. Compose overrides
# this value with its private `postgres` hostname. Use sslmode=verify-full for a managed database.
JELLYRIN_DB_DRIVER=postgresql
DATABASE_URL=postgresql://jellyrin_runtime:CHANGE_ME@127.0.0.1:5432/jellyrin?sslmode=disable
JELLYRIN_DB_MAX_CONNECTIONS=6
JELLYRIN_DB_WORKER_MAX_CONNECTIONS=2
JELLYRIN_DB_ACQUIRE_TIMEOUT_SECONDS=5
JELLYRIN_DB_API_STATEMENT_TIMEOUT_SECONDS=10
JELLYRIN_DB_WORKER_STATEMENT_TIMEOUT_SECONDS=120
JELLYRIN_DB_LOCK_TIMEOUT_SECONDS=3
# Optional shared cache for public catalogue facets (genres, studios, people, tags and years).
# It is cache-aside only: PostgreSQL remains authoritative and Jellyrin bypasses Redis on errors.
# Prefer JELLYRIN_REDIS_URL_FILE with the systemd credential drop-in documented in
# ops/jellyrin-redis-cache.conf.example. Compose deployments may instead set a protected URL:
# JELLYRIN_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
JELLYRIN_CATALOG_CACHE_TTL_SECONDS=30
JELLYRIN_REDIS_COMMAND_TIMEOUT_MILLISECONDS=20
# Provider credentials require one external AES-256-GCM key source. The supplied systemd unit
# sets this variable to its immutable LoadCredential copy. Do not override it here or place key
# material in this environment file. See docs/provider-secrets.md for non-systemd deployments.
RUST_LOG=jellyrin=info,tower_http=info
# Low-resource default for an index/proxy node: allow stream-copy remuxing, never encode;
# Live HLS is forced to video/audio copy under this policy as well.
# Use `disabled` when every client can direct-play; use `enabled` only when transcoding is required.
# Enabled still starts VOD/Live HLS with remux and permits one encode fallback only when the first
# attempt produced no segment; remux-only never permits that fallback.
JELLYRIN_FFMPEG_MODE=enabled
# Aggregate cap shared by encode, remux, auxiliary FFmpeg and ffprobe lanes. Two slots are required
# so an active A/V stream can extract a newly selected embedded subtitle without deadlocking behind
# itself. Per-lane caps still keep that auxiliary work and every heavier lane bounded to one child.
JELLYRIN_MAX_FFMPEG_JOBS=2
JELLYRIN_MAX_VIDEO_TRANSCODES=1
JELLYRIN_MAX_AUDIO_TRANSCODES=1
JELLYRIN_MAX_REMUXES=1
JELLYRIN_MAX_AUXILIARY_FFMPEG_JOBS=1
JELLYRIN_MAX_PROBE_JOBS=1
# Bound ffprobe processes waiting for the shared multimedia cap (0 rejects every wait).
JELLYRIN_MAX_QUEUED_PROBES=8
JELLYRIN_PROBE_QUEUE_TIMEOUT_SECONDS=10
# Lower FFmpeg below the API in the Unix scheduler (0-19, or `off`). The supplied software-only
# systemd unit also uses PrivateDevices; a future hardware-acceleration rollout must explicitly
# relax that sandbox in a reviewed drop-in and expose only the required render devices.
JELLYRIN_FFMPEG_NICE=10
JELLYRIN_TRANSCODE_THREADS=2
JELLYRIN_TRANSCODE_PRESET=ultrafast
# Bound pending work as well as active FFmpeg children (0 rejects all waits).
JELLYRIN_MAX_QUEUED_FFMPEG_JOBS=8
JELLYRIN_TRANSCODE_QUEUE_TIMEOUT_SECONDS=15
JELLYRIN_TRANSCODE_IDLE_TIMEOUT_SECONDS=60
JELLYRIN_LIVE_TRANSCODE_IDLE_TIMEOUT_SECONDS=180
JELLYRIN_LIVE_HLS_LIST_SIZE=20
JELLYRIN_LIVE_HLS_DELETE_THRESHOLD=2
JELLYRIN_REMOTE_VOD_READRATE=1.10
JELLYRIN_REMOTE_VOD_READRATE_INITIAL_BURST_SECONDS=15
# Remote ffprobe is lower priority, single-threaded and killed/reaped at this deadline. Its request
# limiter below is additional to, and never replaces, the shared process admission above.
JELLYRIN_FFPROBE_TIMEOUT_SECONDS=15
JELLYRIN_MAX_REMOTE_PROBES=1
# Bound requests waiting behind the active remote probe (0 rejects every wait).
JELLYRIN_MAX_QUEUED_REMOTE_PROBES=8
JELLYRIN_REMOTE_PROBE_QUEUE_TIMEOUT_SECONDS=10
JELLYRIN_TRANSCODE_DIR=/var/cache/jellyrin/transcodes
JELLYRIN_TRANSCODE_MAX_BYTES=4294967296
# Atomic headroom held per active HLS writer; keep at least one monitor interval of expected output.
JELLYRIN_TRANSCODE_RESERVATION_BYTES=67108864
JELLYRIN_TRANSCODE_RETENTION_MINUTES=60
# Keep false for public providers. Enable only when a trusted provider endpoint is on RFC1918/ULA/loopback.
JELLYRIN_ALLOW_PRIVATE_PROVIDER_URLS=false
# Xtream series synchronization uses bounded category prefetch plus globally shared detail workers.
# Defaults suit this host; accepted ranges are 1-5 and 1-32 respectively.
JELLYRIN_XTREAM_SERIES_CATEGORY_CONCURRENCY=2
JELLYRIN_XTREAM_SERIES_DETAIL_CONCURRENCY=8
# Movie details are enriched lazily and cached in PostgreSQL; bound concurrent provider calls.
JELLYRIN_XTREAM_VOD_DETAIL_CONCURRENCY=5
# One wall-clock budget covers a plugin VOD import and all of its continuation pages. The default
# is two hours; values are clamped to 60-21600 seconds. Durable staging keeps the previous visible
# libraries intact if the provider fails, the request is cancelled, or this deadline expires.
JELLYRIN_VOD_LIBRARY_PROVIDER_CATALOG_TIMEOUT_SECONDS=7200
# Optional fail-closed route for plugins whose playback contract sets
# RequiresProviderEgress=true. Provider deployment overrides should set this to their isolated
# HTTP CONNECT proxy; leave it unset when no installed provider requires dedicated egress.
# JELLYRIN_PROVIDER_EGRESS_PROXY=http://127.0.0.1:18080
# Do not enable local ExternalProcess packages in production. A staging host may
# opt in through the dedicated `ops/jellyrin-magstv-staging.conf.example`
# systemd drop-in while testing an unpublished, checksum-pinned MAGSTV build.
